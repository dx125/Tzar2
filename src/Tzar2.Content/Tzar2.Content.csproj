<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(Tzar2LibraryTargetFramework)</TargetFramework>
    <RootNamespace>Tzar2.Content</RootNamespace>
    <Description>VFS, packages, manifests, rules loader and ruleset compiler.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The ruleset compiler runs on every peer, so its output must not depend on floating point or hash order (ADR 0012). -->
    <Tzar2Deterministic>true</Tzar2Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Tzar2.Core/Tzar2.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tzar2.Content.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Engine-default package (REQ-DATA-02): the built-in rulesets' YAML, served by EngineDefaultsSource. -->
    <EmbeddedResource Include="../../content/engine/**/*.yaml" LogicalName="engine/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
