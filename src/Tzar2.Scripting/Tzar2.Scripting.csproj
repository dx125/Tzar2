<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(Tzar2LibraryTargetFramework)</TargetFramework>
    <RootNamespace>Tzar2.Scripting</RootNamespace>
    <Description>Legacy trigger engine, expression VM, Lua host.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <Tzar2Deterministic>true</Tzar2Deterministic>
    <Tzar2NoIO>true</Tzar2NoIO>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tzar2.Scripting.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Tzar2.Core/Tzar2.Core.csproj" />
    <ProjectReference Include="../Tzar2.Sim/Tzar2.Sim.csproj" />
  </ItemGroup>

</Project>
