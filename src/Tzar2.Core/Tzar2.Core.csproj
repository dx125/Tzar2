<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(Tzar2LibraryTargetFramework)</TargetFramework>
    <RootNamespace>Tzar2.Core</RootNamespace>
    <Description>Fixed-point math, deterministic RNG, hashing, ID types, binary reader/writer (BCL only).</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <Tzar2Deterministic>true</Tzar2Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tzar2.Core.Tests" />
  </ItemGroup>

</Project>
