; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Tzar2"
config/description="Tzar2 client"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Mobile")

[debug]

; Godot's own log (user://logs/godot*.log) also in exported builds: the crash reporter reads the backtrace of a native
; crash from it at the next start (ADR 0243).
file_logging/enable_file_logging.pc=true

[display]

window/size/viewport_width=1440
window/size/viewport_height=900

[dotnet]

project/assembly_name="Tzar2.Client"

[rendering]

; ADR 0010: Mobile renderer (RenderingDevice) by default, Compatibility as the fallback.
renderer/rendering_method="mobile"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
