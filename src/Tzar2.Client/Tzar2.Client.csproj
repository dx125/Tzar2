<Project Sdk="Godot.NET.Sdk/4.7.2">

  <!-- Godot 4.7 .NET presentation layer (TDD §7). The Godot.NET.Sdk version pins the engine version (DEC-01). -->
  <PropertyGroup>
    <!-- Literal on purpose: the Godot editor rewrites a property-based TargetFramework (ADR 0002). -->
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Tzar2.Client</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Tzar2.Game/Tzar2.Game.csproj" />
    <ProjectReference Include="../Tzar2.Content/Tzar2.Content.csproj" />
    <ProjectReference Include="../Tzar2.Import/Tzar2.Import.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tzar2's own order buttons for orders the original has not (BLD-027's dismantle; tools/art makes them). Embedded,
         so they need no Godot import; icons/.gdignore keeps the editor off them. -->
    <EmbeddedResource Include="icons/*.png" LogicalName="icons/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- MIDI music (REQ-AUD-02); allowed for the client only (ADR 0011 map, ADR 0020). -->
    <PackageReference Include="MeltySynth" />
  </ItemGroup>

</Project>
