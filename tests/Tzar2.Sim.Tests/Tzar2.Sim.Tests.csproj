<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(Tzar2LibraryTargetFramework)</TargetFramework>
    <RootNamespace>Tzar2.Sim.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FsCheck" />
    <PackageReference Include="FsCheck.Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Tzar2.Sim/Tzar2.Sim.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Snapshots taken by older versions on synthetic maps (ADR 0271): saves must go on loading. -->
    <EmbeddedResource Include="Fixtures/*.t2snap" LogicalName="Fixtures/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
