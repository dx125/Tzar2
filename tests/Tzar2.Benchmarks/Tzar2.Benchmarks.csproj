<Project Sdk="Microsoft.NET.Sdk">

  <!-- BenchmarkDotNet suite (TDD §21, §22.8). Usage is described in README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(Tzar2LibraryTargetFramework)</TargetFramework>
    <RootNamespace>Tzar2.Benchmarks</RootNamespace>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Tzar2.Core/Tzar2.Core.csproj" />
  </ItemGroup>

</Project>
