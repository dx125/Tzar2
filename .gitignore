# Original game files: copyrighted, NEVER commit (see docs/original-build/README.md).
/Origin/

# Content imported/converted from the original game, local captures and dumps
/imported/
*.t2pkg
**/local-goldens/
**/re-dumps/

# .NET / Godot build output
bin/
obj/
.godot/
*.user

# IDE / OS
.vs/
.idea/
.vscode/*
!.vscode/extensions.json
Thumbs.db
.DS_Store

# Test and benchmark output
TestResults/
BenchmarkDotNet.Artifacts/

# Claude Code local state (agent worktrees)
/.claude/
spikes/S2-determinism/out/

# Python bytecode (tools/re)
__pycache__/

# SoundFonts are downloaded for development only and never committed (tools/soundfont/README.md, ADR 0020)
/soundfonts/
*.sf2
*.sf3

# Capture harness (ADR 0030): returned session zips and extracted raw captures show original art; never commit them.
capture-*.zip
/tests/fidelity/local-captures/
/Tzar2Capture/
# Random maps the operator generates in the original's editor (ADR 0113) are original output: keep them local.
# No .wmp/.wcm file is tracked anywhere (synthetic map fixtures are built in memory by the tests); the REQ-LEGAL-01
# guard (tools/ci/check-no-original-files.sh) rejects these extensions as well.
/tests/fidelity/local-maps/
*.wmp
*.wcm

# Windows packages built by tools/package (ADR 0241).
/artifacts/
/src/Tzar2.Client/Tzar2.Client.sln
