<Project>
  <!--
    Determinism opt-in (TDD §8.8, ADR 0004).
    A project sets <Tzar2Deterministic>true</Tzar2Deterministic> to get the Tzar2.Analyzers rules T2D001-T2D005
    and the [assembly: Tzar2.Core.Tzar2Deterministic] marker. <Tzar2NoIO>true</Tzar2NoIO> additionally enables
    T2D006 (no file/network I/O, REQ-ARCH-01) via [assembly: Tzar2.Core.Tzar2NoIO].
  -->
  <!-- Fixed overflow policy (ADR 0014); Tzar2.Core reads TZAR2_OVERFLOW_SATURATE in OverflowPolicy. -->
  <PropertyGroup Condition="'$(Tzar2OverflowPolicy)' == 'Saturate'">
    <DefineConstants>$(DefineConstants);TZAR2_OVERFLOW_SATURATE</DefineConstants>
  </PropertyGroup>
  <Target Name="Tzar2ValidateOverflowPolicy" BeforeTargets="CoreCompile"
          Condition="'$(Tzar2OverflowPolicy)' != 'Throw' and '$(Tzar2OverflowPolicy)' != 'Saturate'">
    <Error Text="Tzar2OverflowPolicy must be Throw or Saturate, not '$(Tzar2OverflowPolicy)'." />
  </Target>

  <!--
    Every project under src/ (but the analyzers themselves) gets T2C001 (CultureAnalyzer): interpolated strings must not
    format numbers or dates with the machine's culture. The determinism rules stay opt-in (DeterminismAnalyzer).
  -->
  <PropertyGroup>
    <Tzar2Analyzed Condition="'$(Tzar2Deterministic)' == 'true' or '$(Tzar2NoIO)' == 'true'">true</Tzar2Analyzed>
    <Tzar2Analyzed Condition="'$(MSBuildProjectName)' != 'Tzar2.Analyzers' and $([System.String]::Copy('$(MSBuildProjectDirectory)/').StartsWith('$(MSBuildThisFileDirectory)src'))">true</Tzar2Analyzed>
  </PropertyGroup>
  <ItemGroup Condition="'$(Tzar2Analyzed)' == 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/Tzar2.Analyzers/Tzar2.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(Tzar2Deterministic)' == 'true'">
    <AssemblyAttribute Include="Tzar2.Core.Tzar2DeterministicAttribute" />
  </ItemGroup>
  <ItemGroup Condition="'$(Tzar2NoIO)' == 'true'">
    <AssemblyAttribute Include="Tzar2.Core.Tzar2NoIOAttribute" />
  </ItemGroup>
</Project>
